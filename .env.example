# 环境变量
# 所有敏感配置从 GitHub Secrets 读取，本地可用 .secrets/ 目录下的同名文件覆盖

# 智谱 GLM-4-Flash（永久免费）https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# 腾讯云语音识别（每月 10 小时免费额度）https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 引擎模型类型，不是引擎 ID，直接填 16k_zh
TENCENT_ASR_ENGINE_MODEL_ID=16k_zh

# 飞书多维表格 https://open.feishu.cn/app
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=

# 采集行为调优（一般不用改）
SCROLL_MAX_ROUNDS=40
SCROLL_INTERVAL_MS=1500
COLLECT_BATCH_SIZE=100
REQUEST_TIMEOUT_MS=45000
ASR_ENABLED=true
